# Copy this file to .env and fill in your real values.
# .env itself is gitignored and should never be committed.

# Both deployments must support Chat Completions and strict JSON-schema outputs.
# PDF extraction additionally requires image input. Use Azure deployment names.
AZURE_OPENAI_ENDPOINT=https://gpt4-g11n.openai.azure.com
# Shared fallback; keep this while migrating to task-specific deployments.
AZURE_OPENAI_DEPLOYMENT=cont-aud-gpt-6-astra
AZURE_OPENAI_PDF_DEPLOYMENT=
AZURE_OPENAI_BRIEF_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_API_KEY=key

UDT_BASE_URL=https://sarvottam.udtweb.com
UDT_USERNAME=your_username_here
UDT_PASSWORD=your_password_here

# Maximum days to fetch messages and retain messages, PDFs, and cached data.
ARCHIVE_RETENTION_DAYS=35

# Five-field cron for message collection. Default: every 30 minutes.
MESSAGE_POLL_CRON="*/30 * * * *"
MESSAGE_POLL_TIMEZONE=Asia/Kolkata

# Native Evolution setup and QR pairing: docs/EVOLUTION_SETUP.md.
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=school
EVOLUTION_GROUP_JID=

# Required for all native data/control APIs, including health and PDF downloads.
# Generate with openssl rand -hex 32; restart the service after changing it.
SERVICE_API_TOKEN=

# Docker only; native debugging continues using the settings above.
# Use URL-safe random hex values, e.g. openssl rand -hex 32.
DOCKER_POSTGRES_PASSWORD=
DOCKER_SERVICE_API_TOKEN=
