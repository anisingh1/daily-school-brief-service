# Copy this file to .env and fill in your real values.
# .env itself is gitignored and should never be committed.

# Azure deployment must support structured JSON outputs and PDF page images.
AZURE_OPENAI_ENDPOINT=https://gpt4-g11n.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=cont-aud-gpt-6-astra
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_API_KEY=key

UDT_BASE_URL=https://sarvottam.udtweb.com
UDT_USERNAME=your_username_here
UDT_PASSWORD=your_password_here

# Maximum days to fetch messages and retain messages, PDFs, and cached data.
ARCHIVE_RETENTION_DAYS=35

# Five-field cron for message collection. Default: every 30 minutes.
MESSAGE_POLL_CRON="*/30 * * * *"
MESSAGE_POLL_TIMEZONE=Asia/Kolkata

# Gmail SMTP, for sending the daily brief as an HTML email (see
# send_email.py). SMTP_APP_PASSWORD is a Gmail App Password (Google
# Account -> Security -> 2-Step Verification -> App passwords), NOT
# your regular Gmail password - it requires 2FA to be enabled first.
# EMAIL_TO supports a comma-separated list for multiple recipients,
# e.g. EMAIL_TO=a@example.com, b@example.com
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_character_app_password
EMAIL_TO=recipient@example.com

# WhatsApp capture (see fetch_whatsapp.py and docs/PHONE_SETUP.md).
# Phone-side MacroDroid rules email each WhatsApp text message and
# document to this address - a Gmail "+" alias of SMTP_USERNAME (Gmail
# delivers "+" aliases to the same inbox, so this reuses the same
# account/app-password above via IMAP - no separate service required).
# Requires IMAP to be enabled in the Gmail account's settings.
WHATSAPP_EMAIL_TO=your_gmail_address+whatsapp@gmail.com
