{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: service.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/service.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "SERVICE_RELOAD": "true"
            },
            "subProcess": true,
            "justMyCode": true
        }
    ]
}
