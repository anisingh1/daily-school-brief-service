{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: service.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/service.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "SERVICE_RELOAD": "true"
            },
            "subProcess": true,
            "justMyCode": true
        },
        {
            "name": "Debug: Evolution API",
            "type": "node",
            "request": "launch",
            "preLaunchTask": "Native: prepare Evolution",
            "postDebugTask": "Native: stop databases",
            "runtimeExecutable": "node",
            "program": "${workspaceFolder}/../evolution-api/dist/main.js",
            "cwd": "${workspaceFolder}/../evolution-api",
            "console": "internalConsole",
            "internalConsoleOptions": "openOnSessionStart",
            "skipFiles": ["<node_internals>/**"]
        }
    ],
    "compounds": [
        {
            "name": "Debug: service + Evolution",
            "configurations": ["Debug: service.py", "Debug: Evolution API"],
            "stopAll": true
        }
    ]
}
